{
  "name": "smallfold-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "node scripts/copy-tokens.mjs",
    "dev": "npm run tokens && npm run site && next dev -p 3000",
    "build": "npm run tokens && npm run site && next build",
    "start": "next start -p 3000",
    "typecheck": "npm run tokens && tsc --noEmit",
    "test": "vitest run",
    "site": "node ../build.js --out public",
    "lint": "oxlint app lib components proxy.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "1.94.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
