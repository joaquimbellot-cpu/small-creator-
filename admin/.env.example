# Smallfold back office: every setting the app reads.
# Copy this file to admin/.env.local for testing on your computer (the test scripts fill that in for you).
# Online, type each name and value into Vercel's Environment Variables page instead.
# Leave the values empty here. Never put a real key in this file, in git or in chat.
# "SECRET" means keep it private. "Public" means it is safe to show in a browser.

# ---- Supabase (the database and the login) ----
NEXT_PUBLIC_SUPABASE_URL=
# Public. The project URL. Supabase dashboard: Project Settings, then API. Looks like https://abcd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public. The "anon" key. Supabase dashboard: Project Settings, then API. It can read nothing on its own.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. The "service_role" key. Supabase dashboard: Project Settings, then API. Full database access, server only.

# ---- Site address ----
NEXT_PUBLIC_SITE_URL=
# Public. The address the back office is on, with no slash at the end. Local: http://localhost:3000. Online: your Vercel address, for example https://your-app.example.com

# ---- Email sending (Gmail) ----
SMTP_HOST=
# Public. The mail server. For Gmail, type smtp.gmail.com
SMTP_PORT=
# Public. The mail server port. For Gmail, type 465
SMTP_SECURE=
# Public. Type true for port 465 (Gmail). Type false for other ports.
SMTP_USER=
# Personal, not secret. The Gmail address that sends the mail, for example you@example.com
SMTP_PASS=
# SECRET. A Gmail app password (16 letters). Google Account, Security, 2-Step Verification, App passwords. It is not your normal Gmail password.
EMAIL_FROM=
# Public, shown in every email. The sender address. Normally the same as SMTP_USER.

# ---- Claude (drafting emails) ----
ANTHROPIC_API_KEY=
# SECRET. An API key from console.anthropic.com (API Keys). Leave empty to use mock drafting, which fills templates without calling Claude.
ANTHROPIC_MODEL=
# Public. Which Claude model writes drafts. Optional. The app uses claude-sonnet-5-5 when this is empty.
DRAFT_MODE=
# Public. Type mock to fill templates without calling Claude, even if a key is set. Optional. Leave empty for real drafting.

# ---- YouTube (subscriber counts) ----
YOUTUBE_API_KEY=
# SECRET. A YouTube Data API v3 key from Google Cloud Console, Credentials. Restrict it to that API. Empty means the refresh button stays off.
YOUTUBE_API_BASE=
# Public. Optional. Leave empty. Only used by tests, to point at a fake YouTube server.

# ---- Unsubscribe links ----
UNSUBSCRIBE_SECRET=
# SECRET. A long random text that signs unsubscribe links. Make one on your computer with: openssl rand -hex 32. Do not change it later, or old links stop working.

# ---- Testing on your computer only (leave these empty online) ----
GOTRUE_URL=
# Testing only. The address of the local login service. Used by the seed script. Usually http://127.0.0.1:9999
BASE_URL=
# Testing only. The address the browser tests open. Usually http://localhost:3000
SHOT_DIR=
# Testing only. The folder where the email test saves screenshots.
SHOT_PATH=
# Testing only. The file where the deals test saves its screenshot.
SHOTS=
# Testing only. The folder where the login test saves its screenshots.
